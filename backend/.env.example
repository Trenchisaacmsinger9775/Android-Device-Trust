APP_ENV=dev
HOST=0.0.0.0
PORT=8080
APP_KEYS=dev-app-key
REDIS_URL=redis://redis:6379/0
POSTGRES_USER=devicecheck
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=devicecheck
POSTGRES_DSN=postgresql://devicecheck:change-this-postgres-password@postgres:5432/devicecheck
CHALLENGE_TTL_SECONDS=300
CHALLENGE_RATE_LIMIT_PER_MINUTE=60
CHECK_RATE_LIMIT_PER_MINUTE=120
MAX_ATTESTATION_BYTES=262144
DATASTORE_HASH_KEY=change-me
DATASTORE_RETENTION_DAYS=30
RETENTION_CLEANUP_INTERVAL_SECONDS=21600
